
@startuml
title CJM — Пользовательский путь заведения Авито.Кухня

|Сотрудник заведения|
start
:Открывает панель управления;

' ==========================================
' 1. Управление доступностью заведения
' ==========================================

:Проверяет текущий статус заведения;
:Выбирает статус Открыто или Закрыто;

|Система|
:Сохраняет новый статус заведения;

if (Статус успешно изменён?) then (Да)
  :Обновляет доступность заведения для клиентов;
  |Сотрудник заведения|
  :Получает подтверждение изменения статуса;
else (Нет)
  :Возвращает ошибку;
  |Сотрудник заведения|
  :Получает сообщение об ошибке;
endif

' ==========================================
' 2. Просмотр меню
' ==========================================

:Открывает раздел меню;

|Система|
:Загружает список блюд;

if (Меню загружено?) then (Да)
  |Сотрудник заведения|
  :Просматривает список блюд;
  :Проверяет названия, описания, состав,
  цены и наличие;
else (Нет)
  :Возвращает ошибку загрузки меню;
  |Сотрудник заведения|
  :Получает сообщение об ошибке;
endif

' ==========================================
' 3-6. Управление блюдами
' ==========================================

repeat
  |Сотрудник заведения|
  :Выбирает действие с меню;

  if (Добавить блюдо?) then (Да)

    :Указывает название;
    :Указывает описание и состав;
    :Указывает цену;
    :Устанавливает начальное наличие;

    |Система|
    :Проверяет обязательные поля;
    :Проверяет корректность цены;
    :Проверяет уникальность блюда;

    if (Данные корректны?) then (Да)
      :Сохраняет новое блюдо;
      :Обновляет меню;
      |Сотрудник заведения|
      :Получает подтверждение добавления;
    else (Нет)
      :Возвращает ошибки валидации;
      |Сотрудник заведения|
      :Исправляет данные блюда;
    endif

  elseif (Редактировать блюдо?) then (Да)

    :Выбирает существующее блюдо;

    |Система|
    :Загружает информацию о блюде;

    if (Блюдо найдено?) then (Да)
      |Сотрудник заведения|
      :Изменяет название, описание,
      состав или цену;
      :Сохраняет изменения;

      |Система|
      :Проверяет корректность данных;

      if (Данные корректны?) then (Да)
        :Сохраняет изменения;
        :Обновляет информацию в меню;
        |Сотрудник заведения|
        :Получает подтверждение изменения;
      else (Нет)
        :Возвращает ошибку;
        |Сотрудник заведения|
        :Исправляет данные;
      endif
    else (Нет)
      :Возвращает ошибку;
      |Сотрудник заведения|
      :Получает сообщение, что блюдо не найдено;
    endif

  elseif (Изменить наличие блюда?) then (Да)

    :Выбирает блюдо;
    :Устанавливает статус В наличии
    или Нет в наличии;

    |Система|
    :Сохраняет новый статус наличия;
    :Обновляет доступность блюда для клиентов;

    if (Статус изменён?) then (Да)
      |Сотрудник заведения|
      :Получает подтверждение изменения;
    else (Нет)
      :Возвращает ошибку;
      |Сотрудник заведения|
      :Получает сообщение об ошибке;
    endif

  elseif (Удалить блюдо?) then (Да)

    :Выбирает блюдо для удаления;
    :Подтверждает удаление;

    |Система|
    :Проверяет возможность удаления;

    if (Удаление разрешено?) then (Да)
      :Удаляет блюдо из меню;
      :Обновляет список блюд;
      |Сотрудник заведения|
      :Получает подтверждение удаления;
    else (Нет)
      :Возвращает ошибку удаления;
      |Сотрудник заведения|
      :Получает информацию о невозможности удаления;
    endif

  else (Завершить работу с меню)
    :Завершает управление меню;
  endif

repeat while (Продолжить управление меню?) is (Да)
->Нет;

' ==========================================
' 7. Просмотр поступивших заказов
' ==========================================

|Сотрудник заведения|
:Открывает раздел заказов;

|Система|
:Загружает список заказов заведения;

if (Заказы загружены?) then (Да)
  |Сотрудник заведения|
  :Просматривает список заказов;
else (Нет)
  :Возвращает ошибку загрузки;
  |Сотрудник заведения|
  :Получает сообщение об ошибке;
  stop
endif

repeat
  |Сотрудник заведения|
  :Выбирает заказ для просмотра;

  |Система|
  :Загружает подробную информацию о заказе;

  if (Заказ найден?) then (Да)
    |Сотрудник заведения|
    :Проверяет состав заказа;
    :Проверяет количество блюд;
    :Проверяет адрес доставки;
    :Проверяет дату создания;
    :Проверяет текущий статус;
  else (Нет)
    :Возвращает ошибку;
    |Сотрудник заведения|
    :Получает сообщение, что заказ не найден;
    stop
  endif

  ' ==========================================
  ' 8. Принятие или отклонение заказа
  ' ==========================================

  if (Статус заказа = new?) then (Да)

    |Сотрудник заведения|
    :Проверяет доступность блюд;
    :Принимает решение по заказу;

    if (Принять заказ?) then (Да)

      |Система|
      :Проверяет актуальность заказа;

      if (Заказ можно принять?) then (Да)
        :Изменяет статус на accepted;
        :Сохраняет изменение статуса;

        |Сотрудник заведения|
        :Получает подтверждение принятия заказа;

        ' ==========================================
        ' 9. Приготовление заказа
        ' ==========================================

        :Начинает приготовление заказа;

        |Система|
        :Проверяет текущий статус заказа;

        if (Заказ можно перевести в работу?) then (Да)
          :Изменяет статус на in_process;
          :Сохраняет изменение статуса;

          |Сотрудник заведения|
          :Получает подтверждение начала приготовления;
          :Готовит заказ;

          ' ==========================================
          ' 10. Завершение приготовления
          ' ==========================================

          :Завершает приготовление заказа;

          |Система|
          :Проверяет текущий статус заказа;

          if (Заказ можно завершить?) then (Да)
            :Изменяет статус на ready;
            :Сохраняет изменение статуса;
            :Обновляет информацию для клиента;

            |Сотрудник заведения|
            :Получает подтверждение готовности заказа;
          else (Нет)
            :Возвращает ошибку изменения статуса;
            |Сотрудник заведения|
            :Получает информацию о невозможности завершения;
          endif

        else (Нет)
          :Возвращает ошибку изменения статуса;
          |Сотрудник заведения|
          :Получает информацию о невозможности начала приготовления;
        endif

      else (Нет)
        :Возвращает ошибку принятия заказа;
        |Сотрудник заведения|
        :Получает информацию о невозможности принятия;
      endif

    else (Отклонить заказ)

      |Сотрудник заведения|
      :Указывает причину отклонения;
      :Подтверждает отклонение;

      |Система|
      :Проверяет возможность отклонения заказа;

      if (Заказ можно отклонить?) then (Да)
        :Изменяет статус на cancelled;
        :Сохраняет причину отклонения;
        :Обновляет информацию для клиента;

        |Сотрудник заведения|
        :Получает подтверждение отклонения;
      else (Нет)
        :Возвращает ошибку изменения статуса;
        |Сотрудник заведения|
        :Получает информацию о невозможности отклонения;
      endif

    endif

  else (Нет)
    |Система|
    :Проверяет актуальность состояния заказа;

    |Сотрудник заведения|
    :Получает информацию о том,
    что заказ уже обработан;
  endif

repeat while (Есть ещё заказы для обработки?) is (Да)
->Нет;

:Завершает работу с панелью управления;
stop

@enduml
